<Window x:Class="x_y_rotation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:x_y_rotation"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:net="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Vetületi torzulások" Height="450" Width="800">
    <Window.Resources>
        <net:Double x:Key="EarthRadius">6.371</net:Double>
        <net:Double x:Key="EarthDiameter">12.742</net:Double>
        <net:Double x:Key="RightPanelSize">100</net:Double>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <hx:HelixViewport3D Grid.Row="0" x:Name="leftPort" >
                <hx:DefaultLights/>
                <hx:SunLight/>
                <hx:TubeVisual3D x:Name="EuropeEcefLine" ThetaDiv="3"   Diameter=".01" />

                <hx:SphereVisual3D x:Name="LeftEarthSphere"
                   Radius="{Binding Source={StaticResource EarthRadius}}">
                    <hx:SphereVisual3D.Fill>
                        <ImageBrush ImageSource="/HYP_50M_SR_W.tif" Stretch="Fill" TileMode="Tile" >
                            <ImageBrush.RelativeTransform>
                                <TranslateTransform X="-.5"/>
                            </ImageBrush.RelativeTransform>
                        </ImageBrush>

                    </hx:SphereVisual3D.Fill>
                </hx:SphereVisual3D>



                <hx:RectangleVisual3D x:Name="ImagePlane" Width="8" Length="8" Origin="0,0,0.18" Fill="#B35C574F">
                    <hx:LinesVisual3D Color="#666666" Thickness="1"/>

                    <hx:RectangleVisual3D.Transform>
                        <Transform3DGroup>

                            <RotateTransform3D>
                                <RotateTransform3D.Rotation>
                                    <AxisAngleRotation3D Axis="0,1,0" Angle="{Binding Value, BindsDirectlyToSource=True, ElementName=element_y, Mode=OneWay, NotifyOnSourceUpdated=True, ValidatesOnNotifyDataErrors=False}"/>
                                </RotateTransform3D.Rotation>
                            </RotateTransform3D>

                            <RotateTransform3D>
                                <RotateTransform3D.Rotation>
                                    <AxisAngleRotation3D Axis="1,0,0" Angle="{Binding Value, BindsDirectlyToSource=True, ElementName=element_x, Mode=OneWay, NotifyOnSourceUpdated=True, ValidatesOnNotifyDataErrors=False}"/>
                                </RotateTransform3D.Rotation>
                            </RotateTransform3D>

                        </Transform3DGroup>
                    </hx:RectangleVisual3D.Transform>

                </hx:RectangleVisual3D>
                <hx:ArrowVisual3D x:Name="A1" Diameter="0.08">
                </hx:ArrowVisual3D>
                <hx:ArrowVisual3D x:Name="A2" Diameter="0.08">
                </hx:ArrowVisual3D>
                <hx:ArrowVisual3D x:Name="A3" Diameter="0.08">
                </hx:ArrowVisual3D>
                <hx:ArrowVisual3D x:Name="A4" Diameter="0.08">
                </hx:ArrowVisual3D>
            </hx:HelixViewport3D>

            <ComboBox x:Name="ContinentBox"
          Grid.Row="1"
          Width="160"
          Margin="8"
          HorizontalAlignment="Left"
          SelectionChanged="ContinentChanged"
          DisplayMemberPath="Name"/>

            <ComboBox x:Name="ProjectionBox"
          Grid.Row="1"
          Width="200"
          Margin="180,8,0,8"
          HorizontalAlignment="Left"
          SelectionChanged="ProjectionChanged"
          SelectedIndex="0">
                <ComboBoxItem Content="Centrális síkvetület" />
                <ComboBoxItem Content="Lambert-féle síkvetület" />
            </ComboBox>

            <Slider x:Name="element_x" Minimum="-180" Maximum="180" Value="0" VerticalAlignment="Top" ValueChanged="SliderChanged"  Grid.Row="2" TickFrequency="0.1" />
            <Slider x:Name="element_y" Minimum="-180" Maximum="180" Value="0" VerticalAlignment="Top" ValueChanged="SliderChanged"  Grid.Row="2" Margin="0,23,0,0" />
        </Grid>

        <hx:HelixViewport3D x:Name="rightPort" Grid.Column="1"
                            Orthographic="True"
                            IsRotationEnabled="False"
                            IsPanEnabled="True"
                            IsZoomEnabled="True"
                            ShowViewCube="False"
                            Background="#FAF7F2">
               
            <hx:HelixViewport3D.Camera>
                <OrthographicCamera
                            Position="0,0,100"
                            LookDirection="0,0,-100"
                            UpDirection="0,1,0"
                            Width="90">
                </OrthographicCamera>
                     
            </hx:HelixViewport3D.Camera>
            <hx:DefaultLights/>
            <hx:RectangleVisual3D
                Width="{Binding Mode=OneWay, Source={StaticResource RightPanelSize}}"
                Length="{Binding Mode=OneWay, Source={StaticResource RightPanelSize}}"
                Origin="0,0,0"
                Fill="#CCF5DEB3">
            </hx:RectangleVisual3D>


        </hx:HelixViewport3D>
    </Grid>
</Window>